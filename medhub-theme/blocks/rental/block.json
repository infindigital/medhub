{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "medhub/rental",
	"title": "Rental spotlight",
	"category": "medhub",
	"icon": "update",
	"description": "Dark rental section with live rental products (prices shown per month).",
	"attributes": {
		"eyebrow": { "type": "string", "default": "" },
		"heading": { "type": "string", "default": "" },
		"lead": { "type": "string", "default": "" },
		"ctaLabel": { "type": "string", "default": "" },
		"category": { "type": "string", "default": "medical-equipment-rental" },
		"limit": { "type": "number", "default": 8 }
	},
	"supports": { "html": false, "anchor": true },
	"editorScript": "medhub-blocks-editor",
	"render": "file:./render.php"
}
