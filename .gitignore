# Dependencies
node_modules/

# NEVER commit site backups or database dumps – they contain real customer data (PII)
backups/
*.sql
*.sql.gz
*.wpress
*.zip
*.tar
*.tar.gz

# Local environment / secrets
.env
.env.*
wp-config-local.php
*.log

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json

# Scratch
tmp/

# Local WordPress sandbox (dev data only, never committed)
sandbox/

# The static HTML copy in the project root (index.html, product/, assets/ …) is committed;
# it is generated by tooling/export/export-html.mjs, which lists its files in .static-export.json.
html/
